# Copy this file to .env. Never commit the real .env file.
RREADING_GLASSES_IMAGE=ghcr.io/bousborne/rreading-glasses:hardcover-sha-replace-me
RREADING_GLASSES_PULL_POLICY=always
RREADING_GLASSES_STOP_GRACE_PERIOD=40s
HARDCOVER_AUTH=Bearer replace-with-your-hardcover-token
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Conservative Hardcover quota controls.
BATCH_INTERVAL=2s
BATCH_SIZE=1
SEARCH_BATCH_SIZE=1
MAX_PENDING_QUERIES=100
REQUEST_TIMEOUT=30s
RATE_LIMIT_COOLDOWN=15m
SEARCH_RESULTS=5

# Full-author catalogue refresh controls.
AUTHOR_REFRESH_CONCURRENCY=1
AUTHOR_REFRESH_RETRY_BASE=1h
AUTHOR_REFRESH_RETRY_MAX=24h
AUTHOR_REFRESH_MAX_ATTEMPTS=6
AUTHOR_RECOVERY_INTERVAL=5m
